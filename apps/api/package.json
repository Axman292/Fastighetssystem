{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "db:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/scripts/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.44.7",
    "exceljs": "4.4.0",
    "fast-xml-parser": "4.5.3",
    "jszip": "3.10.1",
    "nodemailer": "6.10.1",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.0",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.17.3",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
