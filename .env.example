# Databas (användaren måste kunna köra "set role fastighet_app")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fastighet
# Port för API:et
API_PORT=4000
# Sätts till true i produktion (kräver https)
COOKIE_SECURE=false
# E-post för fakturor. Utan SMTP_HOST sparas e-post som filer i OUTBOX_DIR (testläge)
# SMTP_HOST=smtp.example.se
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hyror@example.se
# OUTBOX_DIR=./outbox
# Automatisk hämtning av inbetalningsfiler från banken (se deploy/BANKFIL.md)
# Hemlig nyckel (minst 16 tecken) som krypterar bankens SSH-nyckel. Byt den inte i onödan.
# APP_SECRET_KEY=
# Mapp på servern som anslutningar av typen "Mapp" får läsa från (frivilligt)
# BANK_FOLDER_ROOT=/var/lib/fastighet/bankfiler
# Stäng av den schemalagda hämtningen (t.ex. i en andra instans)
# BANK_FETCH=off
# Adress till systemet, för länkar i e-postbesked
# PUBLIC_URL=https://fastighet.example.se
